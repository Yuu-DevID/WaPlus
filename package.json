{
  "name": "aurorachat",
  "version": "1.0.0",
  "description": "AuroraChat - WhatsApp Desktop Client",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.aurorachat.desktop",
    "productName": "AuroraChat",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-virtual": "^3.13.19",
    "@vitejs/plugin-react": "^5.1.4",
    "wileys": "latest",
    "jimp": "0.22.12",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "electron": "^40.6.0",
    "framer-motion": "^12.34.3",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react-icons": "^5.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^2.0.3",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "wait-on": "^7.0.1"
  }
}
